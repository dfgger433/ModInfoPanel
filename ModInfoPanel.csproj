<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>ModInfoPanel</AssemblyName>
    <RootNamespace>ModInfoPanel</RootNamespace>
    <Version>1.7.2</Version>
    <Description>Auto-generate item/liquid/creature info panels for mod content (Casualties: Unknown)</Description>
    <GameRoot Condition="'$(GameRoot)' == ''">..\..</GameRoot>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Name="ValidateGameRoot" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameRoot)\CasualtiesUnknown_Data\Managed\Assembly-CSharp.dll')"
           Text="找不到游戏程序集：$(GameRoot)\CasualtiesUnknown_Data\Managed\Assembly-CSharp.dll。请把本仓库放在 &lt;游戏根&gt;\mods\ModInfoPanel（默认相对路径 ..\..），或用 dotnet build -c Release -p:GameRoot=&quot;D:\...\Casualties Unknown Demo&quot; 指定游戏根目录。" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)\CasualtiesUnknown_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameRoot)\CasualtiesUnknown_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRoot)\CasualtiesUnknown_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameRoot)\CasualtiesUnknown_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameRoot)\CasualtiesUnknown_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CUCoreLib">
      <HintPath>$(GameRoot)\BepInEx\plugins\CUCoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(GameRoot)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="src\Locale\locale.zh-CN.json">
      <Link>Locale\locale.zh-CN.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="src\Locale\locale.EN.json">
      <Link>Locale\locale.EN.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
